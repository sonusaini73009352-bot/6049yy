    <!-- Glassmorphism Theme & Custom Palette -->
    <style>
      :root {
        --color-brand-dark: #060B18;
        --color-glass-surface: rgba(15, 23, 42, 0.65);
        --color-glass-card: rgba(255, 255, 255, 0.05);
        --color-glass-border: rgba(255, 255, 255, 0.12);
        --color-glass-border-hover: rgba(56, 189, 248, 0.45);
        --color-cyan-glow: #00E5FF;
        --color-emerald-glow: #10B981;
        --color-gold-glow: #F59E0B;
      }

      /* Headings & Brand Colors */
      .text-brand-blue-dark, h1, h2, h3, h4, .font-display {
        color: #FFFFFF !important;
      }

      /* Ensure cards and animated elements are always crisp & visible */
      .scroll-animate, .scroll-animate-scale, .scroll-animate-left, .scroll-animate-right {
        opacity: 1 !important;
        transform: none !important;
      }

      /* Global Dark Glass Background */
      body {
        background-color: #060B18 !important;
        color: #F8FAFC !important;
        background-image: 
          radial-gradient(circle at 12% 18%, rgba(37, 99, 235, 0.18), transparent 38%),
          radial-gradient(circle at 88% 35%, rgba(139, 92, 246, 0.15), transparent 42%),
          radial-gradient(circle at 25% 72%, rgba(6, 182, 212, 0.14), transparent 40%),
          radial-gradient(circle at 80% 90%, rgba(16, 185, 129, 0.12), transparent 38%) !important;
        background-attachment: fixed !important;
      }

      #root > div {
        background: transparent !important;
      }

      /* Frosted Glass Navigation Header */
      header.sticky {
        background: rgba(6, 11, 24, 0.8) !important;
        backdrop-filter: blur(20px) saturate(180%) !important;
        -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4) !important;
      }
      header.sticky a span.text-brand-blue-dark {
        color: #FFFFFF !important;
      }

      /* Sections Glass Styling */
      section.bg-white, div.bg-white {
        background: rgba(10, 18, 38, 0.72) !important;
        backdrop-filter: blur(18px) !important;
        -webkit-backdrop-filter: blur(18px) !important;
        border-color: rgba(255, 255, 255, 0.08) !important;
      }

      section.bg-gradient-to-b.from-slate-100 {
        background: linear-gradient(180deg, rgba(6, 11, 24, 0.95) 0%, rgba(12, 22, 48, 0.8) 50%, rgba(6, 11, 24, 0.95) 100%) !important;
        border-color: rgba(255, 255, 255, 0.08) !important;
      }

      /* Typography Contrast in Dark Glass Theme */
      .text-slate-900, .text-slate-800, .text-slate-700 {
        color: #F8FAFC !important;
      }
      .text-slate-600, .text-slate-500 {
        color: #94A3B8 !important;
      }
      .border-slate-100, .border-slate-200 {
        border-color: rgba(255, 255, 255, 0.1) !important;
      }
      .bg-slate-50, .bg-slate-100 {
        background: rgba(255, 255, 255, 0.04) !important;
        border-color: rgba(255, 255, 255, 0.1) !important;
      }

      /* Glass Panel Utility */
      .glass-panel {
        background: rgba(255, 255, 255, 0.05) !important;
        backdrop-filter: blur(16px) saturate(180%) !important;
        -webkit-backdrop-filter: blur(16px) saturate(180%) !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.18) !important;
      }

      /* Glass Hover Shimmer */
      .glass-panel:hover {
        border-color: rgba(56, 189, 248, 0.4) !important;
        box-shadow: 0 16px 45px 0 rgba(0, 0, 0, 0.45), 0 0 25px rgba(56, 189, 248, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.3) !important;
      }

      /* Frosted Glass Floating Bottom Bar */
      aside[aria-label="Join Official Telegram"] {
        background: rgba(6, 12, 26, 0.88) !important;
        backdrop-filter: blur(24px) saturate(180%) !important;
        -webkit-backdrop-filter: blur(24px) saturate(180%) !important;
        border-top: 1px solid rgba(255, 255, 255, 0.14) !important;
        box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.7) !important;
      }

      /* ========================================================
         ULTRA-TACTILE 3D BUTTONS SYSTEM
         ======================================================== */
      .btn-3d-telegram {
        position: relative !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 12px !important;
        background: linear-gradient(180deg, #38c8f8 0%, #0099e6 38%, #0077b3 72%, #005986 100%) !important;
        color: #ffffff !important;
        font-family: 'Outfit', sans-serif !important;
        font-weight: 900 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.06em !important;
        border-radius: 18px !important;
        border: 1px solid rgba(255, 255, 255, 0.55) !important;
        border-bottom: 2px solid #003852 !important;
        box-shadow: 
          0 6px 0 #003852,
          0 14px 28px rgba(0, 153, 230, 0.45),
          0 6px 16px rgba(0, 0, 0, 0.65),
          inset 0 1px 0 rgba(255, 255, 255, 0.85),
          inset 0 -2px 0 rgba(0, 0, 0, 0.28) !important;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6) !important;
        cursor: pointer !important;
        transition: transform 0.12s cubic-bezier(0.3, 0, 0.2, 1), box-shadow 0.12s cubic-bezier(0.3, 0, 0.2, 1), background 0.15s ease !important;
        user-select: none !important;
        -webkit-user-select: none !important;
        touch-action: manipulation !important;
        transform: translateY(0);
      }

      .btn-3d-telegram:hover {
        transform: translateY(-2px) !important;
        background: linear-gradient(180deg, #52d2ff 0%, #14a8f5 38%, #008cd4 72%, #00689c 100%) !important;
        box-shadow: 
          0 8px 0 #003852,
          0 20px 36px rgba(0, 170, 255, 0.6),
          0 8px 20px rgba(0, 0, 0, 0.75),
          inset 0 1px 0 rgba(255, 255, 255, 0.95),
          inset 0 -2px 0 rgba(0, 0, 0, 0.28) !important;
      }

      .btn-3d-telegram:active {
        transform: translateY(4px) !important;
        box-shadow: 
          0 2px 0 #003852,
          0 4px 12px rgba(0, 136, 204, 0.35),
          0 2px 6px rgba(0, 0, 0, 0.5),
          inset 0 1px 0 rgba(255, 255, 255, 0.5),
          inset 0 -1px 0 rgba(0, 0, 0, 0.35) !important;
      }

      /* 3D Gold / Amber Accent Button */
      .btn-3d-gold {
        position: relative !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 12px !important;
        background: linear-gradient(180deg, #ffcf40 0%, #ff9900 42%, #e67300 75%, #b34700 100%) !important;
        color: #ffffff !important;
        font-family: 'Outfit', sans-serif !important;
        font-weight: 900 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.06em !important;
        border-radius: 18px !important;
        border: 1px solid rgba(255, 255, 255, 0.65) !important;
        border-bottom: 2px solid #732b00 !important;
        box-shadow: 
          0 6px 0 #732b00,
          0 14px 28px rgba(255, 153, 0, 0.45),
          0 6px 16px rgba(0, 0, 0, 0.65),
          inset 0 1px 0 rgba(255, 255, 255, 0.9),
          inset 0 -2px 0 rgba(0, 0, 0, 0.3) !important;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6) !important;
        cursor: pointer !important;
        transition: transform 0.12s cubic-bezier(0.3, 0, 0.2, 1), box-shadow 0.12s cubic-bezier(0.3, 0, 0.2, 1), background 0.15s ease !important;
        user-select: none !important;
        -webkit-user-select: none !important;
        touch-action: manipulation !important;
        transform: translateY(0);
      }

      .btn-3d-gold:hover {
        transform: translateY(-2px) !important;
        background: linear-gradient(180deg, #ffdb5c 0%, #ffa81a 42%, #f57d05 75%, #cc5200 100%) !important;
        box-shadow: 
          0 8px 0 #732b00,
          0 20px 36px rgba(255, 170, 0, 0.6),
          0 8px 20px rgba(0, 0, 0, 0.75),
          inset 0 1px 0 rgba(255, 255, 255, 1),
          inset 0 -2px 0 rgba(0, 0, 0, 0.3) !important;
      }

      .btn-3d-gold:active {
        transform: translateY(4px) !important;
        box-shadow: 
          0 2px 0 #732b00,
          0 4px 12px rgba(255, 153, 0, 0.35),
          0 2px 6px rgba(0, 0, 0, 0.5),
          inset 0 1px 0 rgba(255, 255, 255, 0.5),
          inset 0 -1px 0 rgba(0, 0, 0, 0.35) !important;
      }
    </style>

  </head>
