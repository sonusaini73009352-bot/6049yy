</div></section><footer class="bg-[#0A192F] text-slate-300 py-12 border-t border-blue-900/60"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="mb-8 pb-8 border-b border-blue-900/60 text-left"><div class="max-w-2xl space-y-4"><div class="flex items-center gap-3"><div class="w-8 h-8 rounded-lg overflow-hidden flex items-center justify-center border-2 border-amber-400/60 bg-white shrink-0"><img alt="Vishv Book Publication" class="w-full h-full object-cover" src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhuWtlZquEBdrM30uiCsJ7wfcOx5dMBtsDbbTu8vEcI86FY3GLzZh2DSApHhyphenhyphen5Q1no9gA0CLy4x5cWOykndjzAqnu6YyGv2grFeOZwwxoqq8-yiyqdrCPItVTT8ij1Gjba9ilbewokb2_ij5FAgP_irv7oudrLmMb01urZrcuLyQjR-0-Se2sWKh4ddnNw/s320/e2OvtXEnqt-zgv4PWQ8q7z6DzzqZ0lOHjgbyWmAyZSW62xFgI77R8-Qh6FT907C4a36r3yUZrtv4u331H1Qezj52hjxmxkpX7ESDmww0mS...6b5JoylgworDdHkGPu7XDqG1ZrjJpRe46AASOvmo1pSzGiDKgvLvTqGD7H86dvPggI26YJLfZS9TNzJMLqIV-V5Jp_vkMHdh8MiA8ZgDHFq8fcRMbF_ks1Gsiw.jpg"/></div><span class="text-sm font-bold text-white tracking-wider uppercase font-display">VISHV BOOK PUBLICATION</span></div><p class="text-xs text-slate-400 leading-relaxed">Official registration facilitation and remote job allocation platform. Registered as Vishv Book Publication under the Companies Act to empower structured remote data entry and writing assignments nationwide.</p><div class="text-[10px] text-slate-400 flex flex-wrap gap-x-4 gap-y-1"><span>CIN: U93000HR2011FTC043854</span><span class="hidden sm:inline text-amber-400">•</span><span>GST: 06AABCF8072B1ZY</span></div></div></div><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-[11px] text-slate-400 text-left"><div class="space-y-1"><p>© 2026 Vishv Book Publication. All Rights Reserved.</p><p class="text-slate-500">Design by <a class="hover:text-amber-400 transition-colors font-semibold underline underline-offset-2" href="https://bharatx-website-agency.vercel.app/" rel="noopener noreferrer" target="_blank">BharatX Web Agency</a></p></div><div class="flex items-center gap-2 text-xs text-slate-400"><span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span><span>All Rights Reserved &amp; Secured</span></div></div></div></footer><aside aria-label="Join Official Telegram" class="fixed bottom-0 left-0 right-0 z-50 bg-[#071326]/95 backdrop-blur-2xl border-t border-cyan-500/30 py-2.5 px-3 sm:px-6 shadow-[0_-12px_40px_rgba(0,0,0,0.8)]" style="padding-bottom: max(0.6rem, env(safe-area-inset-bottom, 0.6rem));">
  <div class="max-w-4xl mx-auto flex items-center justify-center">
    <button onclick="triggerTelegram('sticky_bottom_bar')" class="btn-3d-telegram w-full py-3.5 sm:py-4 px-6 sm:px-12 text-sm sm:text-base font-black tracking-wider shadow-2xl">
      <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>
      <span>JOIN TELEGRAM CHANNEL NOW</span>
      <svg class="w-4 h-4 ml-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
    </button>
  </div>
</aside></main></div>
    </div>
    
    <script>
      const TELEGRAM_URL = "https://t.me/+uPX4ZW0enGs1MDFl";

      function triggerTelegram(placement) {
        try {
          if (typeof window !== "undefined" && window.fbq) {
            window.fbq("track", "Lead", {
              content_name: "Join Telegram Remote Work Cell",
              content_category: "Onboarding Recruitment",
              placement: placement || "general"
            });
          }
        } catch (e) {
          console.error("Pixel track error:", e);
        }
        setTimeout(() => {
          try {
            if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
              window.location.href = TELEGRAM_URL;
            } else {
              window.open(TELEGRAM_URL, "_blank", "noopener,noreferrer");
            }
          } catch {
            window.location.href = TELEGRAM_URL;
          }
        }, 200);
      }

      const ICONS = {
        clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
        user: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
        alert: '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>',
        check: '<path d="M21.8 10A10 10 0 1 1 17 3.3"/><path d="m9 11 3 3L22 4"/>',
        file: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
        shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
        award: '<circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>',
        sparkles: '<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/>'
      };
      const ico = (name, cls="w-4 h-4") => `<svg class="${cls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">${ICONS[name]}</svg>`;

      const plans = [
        {
          num: "01", badge: "7-Day Fast Cycle", 
          badge_cls: "from-rose-500/90 to-pink-600/90 text-white border-rose-400/40 shadow-rose-500/30",
          card_border: "border-rose-500/30 hover:border-rose-400 bg-slate-900/40 hover:bg-slate-900/60 shadow-rose-950/20",
          num_bg: "bg-rose-500/15 text-rose-300 border-rose-500/30", 
          cat_color: "text-rose-400", 
          title_color: "text-white",
          title: "PROJECT PLAN 1", 
          box_bg: "bg-rose-500/15 border-rose-500/30 text-rose-300", 
          icon_color: "text-rose-400",
          pages: "50 Pages <span class=\"text-slate-400 font-normal text-xs\">(100 Sides)</span>",
          duration: "7 Days Limit", duration_cls: "text-rose-400",
          salary_bg: "from-rose-600 via-rose-500 to-pink-600 text-white shadow-rose-500/30", salary_icon: "text-amber-300",
          salary: "₹22,000/-", reg_bg: "bg-white/[0.04] border-white/10 text-slate-200", reg_fee: "₹550/-", scale: ""
        },
        {
          num: "02", badge: "Most Popular", 
          badge_cls: "from-amber-400 to-amber-500 text-slate-950 border-amber-300 font-black shadow-amber-500/40",
          card_border: "border-amber-400/60 hover:border-amber-300 bg-slate-900/60 hover:bg-slate-900/80 shadow-amber-950/40 ring-1 ring-amber-400/30",
          num_bg: "bg-amber-400/20 text-amber-300 border-amber-400/40", 
          cat_color: "text-amber-400", 
          title_color: "text-white",
          title: "PROJECT PLAN 2", 
          box_bg: "bg-amber-400/15 border-amber-400/30 text-amber-300", 
          icon_color: "text-amber-400",
          pages: "80 Pages <span class=\"text-slate-400 font-normal text-xs\">(160 Sides)</span>",
          duration: "15 Days Limit", duration_cls: "text-amber-300",
          salary_bg: "from-amber-500 via-amber-400 to-yellow-500 text-slate-950 shadow-amber-400/40 font-black", salary_icon: "text-slate-900",
          salary: "₹28,000/-", reg_bg: "bg-amber-400/10 border-amber-400/25 text-amber-200", reg_fee: "₹850/-", scale: "scale-[1.02] z-10"
        },
        {
          num: "03", badge: "Max Value", 
          badge_cls: "from-cyan-500/90 to-blue-600/90 text-white border-cyan-400/40 shadow-cyan-500/30",
          card_border: "border-cyan-500/30 hover:border-cyan-400 bg-slate-900/40 hover:bg-slate-900/60 shadow-cyan-950/20",
          num_bg: "bg-cyan-500/15 text-cyan-300 border-cyan-500/30", 
          cat_color: "text-cyan-400", 
          title_color: "text-white",
          title: "PROJECT PLAN 3", 
          box_bg: "bg-cyan-500/15 border-cyan-500/30 text-cyan-300", 
          icon_color: "text-cyan-400",
          pages: "120 Pages <span class=\"text-slate-400 font-normal text-xs\">(240 Sides)</span>",
          duration: "30 Days Limit", duration_cls: "text-cyan-400",
          salary_bg: "from-blue-600 via-cyan-600 to-teal-500 text-white shadow-cyan-500/30", salary_icon: "text-amber-300",
          salary: "₹45,000/-", reg_bg: "bg-white/[0.04] border-white/10 text-slate-200", reg_fee: "₹1250/-", scale: ""
        }
      ];

      const projects = [
        {
          id: "VBP-001", cat: "Data Entry", tag_cls: "text-cyan-300 bg-cyan-500/15 border-cyan-400/30",
          accent: "from-cyan-400 via-blue-500 to-indigo-600", border: "hover:border-cyan-400/60",
          title: "Document Processing Specialist", posted: "2 hours ago",
          desc: "Accurately convert scanned PDF manuscript files, tabular worksheets, and handwritten survey logs into structured Excel/CSV documents. This project requires focus, adherence to specific layout guides, and timely submission of daily batches.",
          duration: "Ongoing (Full/Part Time)", level: "Beginner", vacancies: "14 left", reward: "₹28,000", reward_cls: "text-cyan-400"
        },
        {
          id: "VBP-002", cat: "Prose & Editing", tag_cls: "text-amber-300 bg-amber-500/15 border-amber-400/30",
          accent: "from-amber-400 via-yellow-400 to-amber-500", border: "hover:border-amber-400/60",
          title: "Technical Proofreader & Copy Editor", posted: "5 hours ago",
          desc: "Review and refine standard operating procedures, customer help desk documentation, and software product manuals. Ensure tone uniformity, grammatical precision, and formatting compliance across all files.",
          duration: "3 Months (Extendable)", level: "Intermediate", vacancies: "6 left", reward: "₹32,000", reward_cls: "text-amber-400"
        },
        {
          id: "VBP-003", cat: "Transcription", tag_cls: "text-rose-300 bg-rose-500/15 border-rose-400/30",
          accent: "from-rose-500 via-pink-500 to-purple-600", border: "hover:border-rose-400/60",
          title: "Audio Transcriptionist (Bilingual)", posted: "Yesterday",
          desc: "Listen to pre-recorded bilingual webinar sessions, customer feedback voicemail recordings, and focus group interviews to produce clear, structured written transcripts in verbatim or clean-read format.",
          duration: "Ongoing", level: "Beginner", vacancies: "11 left", reward: "₹26,000", reward_cls: "text-rose-400"
        },
        {
          id: "VBP-004", cat: "Support Operations", tag_cls: "text-blue-300 bg-blue-500/15 border-blue-400/30",
          accent: "from-blue-500 via-indigo-500 to-cyan-400", border: "hover:border-blue-400/60",
          title: "Virtual Support Specialist (Email/Chat)", posted: "1 day ago",
          desc: "Support a growing client base by replying directly to incoming customer emails, support tickets, and live chat queries. Utilize structured template macros to provide rapid, precise answers about delivery statuses, refund requests, and plan features.",
          duration: "6 Months", level: "Intermediate", vacancies: "8 left", reward: "₹30,000", reward_cls: "text-blue-400"
        },
        {
          id: "VBP-005", cat: "Transcription", tag_cls: "text-emerald-300 bg-emerald-500/15 border-emerald-400/30",
          accent: "from-emerald-400 via-teal-500 to-cyan-500", border: "hover:border-emerald-400/60",
          title: "Medical Transcriptionist Trainee", posted: "2 days ago",
          desc: "Listen to clinical records dictated by global doctors and convert them into official medical documents. Structured guidance will be provided, but accuracy must be over 98% because these documents enter official patient charts.",
          duration: "Ongoing", level: "Beginner", vacancies: "16 left", reward: "₹34,000", reward_cls: "text-emerald-400"
        },
        {
          id: "VBP-006", cat: "Language Services", tag_cls: "text-purple-300 bg-purple-500/15 border-purple-400/30",
          accent: "from-indigo-500 via-purple-500 to-pink-500", border: "hover:border-purple-400/60",
          title: "Localization Analyst (English to Hindi/Tamil/Telugu)", posted: "3 days ago",
          desc: "Translate and localize educational course modules, corporate compliance memos, and interface prompts into standard regional vernaculars while retaining the original context and cultural clarity.",
          duration: "4 Months", level: "Advanced", vacancies: "5 left", reward: "₹35,000", reward_cls: "text-purple-400"
        }
      ];

      document.addEventListener("DOMContentLoaded", function () {
        const plansGrid = document.getElementById("plans-grid");
        if (plansGrid) {
          plansGrid.innerHTML = plans.map(p => `
            <div onclick="triggerTelegram('plan_card_${p.num}')" class="relative rounded-3xl p-6 sm:p-8 border backdrop-blur-xl transition-all duration-300 shadow-xl hover:shadow-2xl hover:-translate-y-1.5 group scroll-animate-scale cursor-pointer glass-panel ${p.card_border} ${p.scale}">
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-gradient-to-r ${p.badge_cls} text-[11px] font-bold uppercase tracking-wider py-1 px-4 rounded-full shadow-lg border flex items-center gap-1.5 whitespace-nowrap">
                ${ico('clock', 'w-3.5 h-3.5')}${p.badge}
              </div>
              <div class="flex items-center justify-between mb-6 pt-2">
                <span class="w-10 h-10 rounded-2xl ${p.num_bg} font-black font-display text-sm flex items-center justify-center border shadow-xs">${p.num}</span>
                <span class="text-xs font-black uppercase tracking-widest ${p.cat_color}">ALLOCATION DECK</span>
              </div>
              <h3 class="text-2xl font-black font-display ${p.title_color} mb-6 tracking-tight">${p.title}</h3>
              <div class="space-y-4 border-t border-white/10 pt-6 mb-8 text-sm">
                <div class="flex items-center justify-between">
                  <span class="text-slate-300 flex items-center gap-2">
                    <span class="p-1 rounded-md ${p.box_bg}">${ico('file', 'w-4 h-4 ' + p.icon_color)}</span>Scope
                  </span>
                  <span class="font-bold text-white">${p.pages}</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-slate-300 flex items-center gap-2">
                    <span class="p-1 rounded-md ${p.box_bg}">${ico('clock', 'w-4 h-4 ' + p.icon_color)}</span>Timeframe
                  </span>
                  <span class="font-extrabold ${p.duration_cls}">${p.duration}</span>
                </div>
                <div class="flex items-center justify-between border-t border-dashed border-white/10 pt-3">
                  <span class="text-xs text-slate-400">Quality Benchmark</span>
                  <span class="font-mono text-xs font-bold text-emerald-400 bg-emerald-500/15 px-2 py-0.5 rounded border border-emerald-400/30">≥ 90% ACCURACY</span>
                </div>
              </div>
              <div class="space-y-3 mb-6">
                <div class="rounded-2xl p-4 bg-gradient-to-br ${p.salary_bg} shadow-lg relative overflow-hidden">
                  <div class="relative z-10 flex items-center justify-between">
                    <div>
                      <div class="text-[10px] font-bold tracking-widest uppercase opacity-90">PROJECT SALARY</div>
                      <div class="text-2xl font-black font-mono tracking-tight">${p.salary}</div>
                    </div>
                    ${ico('award', 'w-7 h-7 ' + p.salary_icon + ' shrink-0 opacity-90')}
                  </div>
                </div>
                <div class="flex items-center justify-between p-3.5 rounded-2xl ${p.reg_bg} border text-xs">
                  <span class="font-bold flex items-center gap-1.5 text-slate-200">
                    ${ico('shield', 'w-4 h-4 text-amber-400 shrink-0')}Registration Fee
                  </span>
                  <span class="font-black font-mono text-base text-white">${p.reg_fee}</span>
                </div>
              </div>
              <div class="text-center text-[11px] font-semibold text-slate-400 flex items-center justify-center gap-1 group-hover:text-cyan-300 transition-colors">
                <span>Click to Claim Assignment</span>
                <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </div>
            </div>
          `).join("");
        }

        const carousel = document.getElementById("project-carousel");
        if (carousel) {
          carousel.innerHTML = projects.map((p, i) => `
            <div class="w-[290px] sm:w-[360px] shrink-0 snap-start glass-panel rounded-2xl border border-white/10 p-6 pt-8 flex flex-col justify-between shadow-xl hover:shadow-cyan-500/10 hover:scale-[1.02] transition-all duration-300 relative overflow-hidden group scroll-animate-scale ${p.border}" style="transition-delay:${i*100}ms">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r ${p.accent}"></div>
              <div class="flex items-center justify-between gap-1.5 text-xs text-slate-400 font-medium mb-3">
                <span class="px-2 py-0.5 rounded-full border text-[10px] font-bold ${p.tag_cls}">${p.cat}</span>
                <span class="font-mono text-[11px] text-slate-400">${p.id}</span>
              </div>
              <div class="space-y-1 mb-4">
                <h3 class="text-lg font-bold text-white font-display group-hover:text-cyan-300 transition-colors">${p.title}</h3>
                <p class="text-xs text-slate-400">Posted: ${p.posted}</p>
              </div>
              <p class="text-sm text-slate-300 line-clamp-3 mb-6 leading-relaxed">${p.desc}</p>
              <div class="border-t border-white/10 pt-4 mt-auto space-y-3 text-xs">
                <div class="flex items-center justify-between text-slate-300">
                  <span class="flex items-center gap-1.5 text-slate-400">${ico('clock', 'w-4 h-4 text-slate-400')}Duration</span>
                  <span class="font-semibold text-white">${p.duration}</span>
                </div>
                <div class="flex items-center justify-between text-slate-300">
                  <span class="flex items-center gap-1.5 text-slate-400">${ico('user', 'w-4 h-4 text-slate-400')}Level</span>
                  <span class="font-semibold text-white">${p.level}</span>
                </div>
                <div class="flex items-center justify-between text-slate-300">
                  <span class="flex items-center gap-1.5 text-slate-400">${ico('alert', 'w-4 h-4 text-amber-400')}Vacancies</span>
                  <span class="font-bold text-amber-400 font-mono tabular-nums">${p.vacancies}</span>
                </div>
                <div class="bg-white/[0.04] border border-white/10 p-3 rounded-xl flex items-center justify-between mt-2">
                  <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wide">ESTIMATED COMPENSATION</span>
                  <span class="text-sm font-black font-mono ${p.reward_cls}">${p.reward}</span>
                </div>
              </div>
              <div class="w-full mt-5 bg-white/[0.04] border border-white/10 py-2.5 px-4 rounded-xl text-center flex items-center justify-between text-xs font-semibold text-slate-300">
                <span class="flex items-center gap-1.5 text-emerald-400 font-bold">${ico('check', 'w-4 h-4 text-emerald-400')}Verified Task</span>
                <span class="text-[11px] font-mono text-slate-400">Live Intake</span>
              </div>
            </div>
          `).join("");
        }

        const prevBtn = document.getElementById("carousel-prev");
        const nextBtn = document.getElementById("carousel-next");
        if (carousel && prevBtn && nextBtn) {
          prevBtn.addEventListener("click", () => carousel.scrollBy({ left: -340, behavior: "smooth" }));
          nextBtn.addEventListener("click", () => carousel.scrollBy({ left: 340, behavior: "smooth" }));
        }
      });
    </script>
  </body>
</html>
